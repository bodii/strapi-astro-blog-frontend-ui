---
import Banner from "../components/Banner.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

import { getGlobalData } from "../services/global_service";

const globalData = await getGlobalData();
const { noticeBanner, header, footer } = globalData ?? {};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro + Strapi</title>
		<meta
			name="description"
			content="A modern Astro and Strapi example project"
		/>
	</head>
	<body class="min-h-screen flex flex-col">
		{noticeBanner && <Banner data={noticeBanner} />}
		<Header data={header} />
		<main class="flex-1">
			<slot />
		</main>
		{footer && <Footer data={footer} />}
	</body>
</html>
