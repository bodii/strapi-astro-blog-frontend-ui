---
import type { QuoteProps } from "../../types/components-types/shared_data";

interface Props {
    data: QuoteProps;
}

const { data } = Astro.props;
const quoteText = data.text || data.body || "";
const authorName = data.title || "";
---

<figure
    class="rounded-[28px] border border-primary-100 bg-gradient-to-r from-primary-50 via-white to-surface-alt p-8 shadow-[0_20px_45px_rgba(15,23,42,0.04)] sm:p-10"
>
    <blockquote
        class="text-xl leading-relaxed text-secondary italic sm:text-2xl"
    >
        “{quoteText}”
    </blockquote>
    {
        authorName && (
            <figcaption class="mt-5 text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">
                {authorName}
            </figcaption>
        )
    }
</figure>
