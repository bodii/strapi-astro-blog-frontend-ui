---
import type { CardProps } from "../../types/components-types/shared_data";

interface Props {
    data: CardProps;
}

const { data } = Astro.props;
---

<div
    class="rounded-card border border-border bg-surface-raised p-6 shadow-sm transition hover:border-border-hover hover:shadow-md"
>
    <h3 class="font-heading text-xl font-semibold text-secondary">
        {data.heading}
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-muted">{data.text}</p>
</div>
