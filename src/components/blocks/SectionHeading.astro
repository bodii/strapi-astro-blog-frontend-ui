---
import type { SectionHeadingProps } from "../../types/components-types/block_data";

interface Props {
  data: SectionHeadingProps;
}

const {
  data: { heading, subHeading, anchorLink },
} = Astro.props;
---

<section id={anchorLink}>
  <div class="mx-auto max-w-6xl px-6 pt-24 pb-10">
    <div class="mx-auto max-w-2xl text-center">
      <p
        class="text-sm font-semibold uppercase tracking-wider text-primary-600"
      >
        {subHeading}
      </p>
      <h2
        class="mt-2 text-3xl font-bold tracking-tight text-secondary sm:text-4xl font-heading"
      >
        {heading}
      </h2>
    </div>
  </div>
</section>
